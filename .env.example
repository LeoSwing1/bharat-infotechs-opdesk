# Core
DATABASE_URL=postgresql://postgres:password@localhost:5432/opsdesk
AUTH_SECRET=replace-with-a-long-random-secret
DEMO_MODE=true
NEXT_PUBLIC_APP_NAME=OPDesk
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMTP / email integration
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=OPDesk <no-reply@example.com>

# Google Calendar integration (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# 32-byte (64 hex char) key used to encrypt stored Google OAuth tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# WhatsApp via Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_ENABLED=false

# Web Push / browser notifications (optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Automation
AUTOMATION_SECRET=replace-with-a-cron-secret

# Workforce timezone (defaults to India)
OPDESK_TIMEZONE=Asia/Kolkata
